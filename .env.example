# Production: point this domain at the server before starting Docker.
SITE_ADDRESS=pagoda.example.com
PUBLIC_ORIGIN=https://pagoda.example.com
NODE_ENV=production
ROOM_MAX_CLIENTS=100
NETWORK_TICK=10
BOT_COUNT=20
HTTP_PORT=80
HTTPS_PORT=443

# Private statistics: choose your own nonempty slug (letters/numbers/_/-) and password.
# Leave empty to disable the management page. Use compose.analytics.yaml to pass these to Docker.
ANALYTICS_PATH=
ANALYTICS_PASSWORD=
